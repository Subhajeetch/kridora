{
  "name": "kridora",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:generate": "pnpm --filter @kridora/db db:generate",
    "db:migrate": "pnpm --filter @kridora/api d1:migrate:local",
    "db:migrate:remote": "pnpm --filter @kridora/api d1:migrate:remote",
    "db:studio": "pnpm --filter @kridora/db db:studio"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.8",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.25.0"
}
