{
  "name": "kridora",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:generate": "pnpm --filter @kridora/db db:generate",
    "db:migrate": "pnpm --filter @kridora/api d1:migrate:local",
    "db:migrate:remote": "pnpm --filter @kridora/api d1:migrate:remote",
    "db:studio": "pnpm --filter @kridora/db db:studio"
  },
  "devDependencies": {
    "d3-contour": "^4.0.3",
    "prettier": "3.10.1",
    "sharp": "^0.35.5",
    "simplify-js": "^1.2.4",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.25.0"
}
