{
  "name": "@kridora/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 2020",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "pnpm --filter @kridora/db db:migrate && wrangler deploy",
    "cf-typegen": "wrangler types",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@kridora/db": "workspace:*",
    "@kridora/shared": "workspace:*",
    "better-auth": "^1.2.7",
    "hono": "^4.10.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260401.0",
    "@kridora/typescript-config": "workspace:*",
    "typescript": "7.0.2",
    "wrangler": "^4.122.0"
  }
}