{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kridora-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kridora",
      "database_id": "e2805504-460e-4bce-b8b8-3dc7d0594872",
      "migrations_dir": "../../packages/db/drizzle"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "REALTIME_HUB",
        "class_name": "RealtimeHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RealtimeHub"]
    }
  ]
}
