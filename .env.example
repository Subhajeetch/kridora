NODE_ENV=development

# ---- API -------------------------------------------------------------------
PORT=2020
HOST=0.0.0.0
# Public URL of the WEB app (also the trusted origin for auth + sockets).
# In dev the Vite server proxies /api and /ws to the API, so everything is same-origin.
APP_URL=http://localhost:5173
WEB_URL=http://localhost:5173
BETTER_AUTH_URL=http://localhost:2020

# ---- Database ---------------------------------------------------------------
# Handled automatically via Cloudflare D1 binding (DB) in wrangler.jsonc.
# Local migrations: pnpm db:migrate
# Remote migrations: pnpm db:migrate:remote

# ---- Better Auth ------------------------------------------------------------
# Generate with:  openssl rand -base64 32      (min 32 chars)
BETTER_AUTH_SECRET=

# Google sign-in (optional). Redirect URI to register in Google Cloud Console:
#   http://localhost:5173/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
