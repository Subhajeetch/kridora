NODE_ENV=development

# ---- API -------------------------------------------------------------------
PORT=2020
HOST=0.0.0.0
# Public URL of the WEB app (also the trusted origin for auth + sockets).
# In dev the Vite server proxies /api and /socket.io to the API, so everything is same-origin.
APP_URL=http://localhost:5173
# Set to true ONLY when the API runs behind a reverse proxy / load balancer you control.
TRUST_PROXY=false

# ---- Postgres (must match docker-compose.yml) -------------------------------
POSTGRES_USER=kridora
POSTGRES_PASSWORD=kridora
POSTGRES_DB=kridora
DATABASE_URL=postgres://kridora:kridora@localhost:5432/kridora

# ---- Redis -------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---- Better Auth ------------------------------------------------------------
# Generate with:  openssl rand -base64 32      (min 32 chars)
BETTER_AUTH_SECRET=

# Google sign-in (optional). Redirect URI to register in Google Cloud Console:
#   http://localhost:5173/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
